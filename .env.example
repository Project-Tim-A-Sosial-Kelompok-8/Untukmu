# Dari akar proyek: python scripts/init_env.py (Windows: py -3.12 scripts/init_env.py).
# Template ini bukan .env siap pakai; generator membuat password/kunci acak yang sinkron.
# Jangan membagikan .env atau memakai password PostgreSQL pribadi dari instalasi lain.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
POSTGRES_USER=untukmu
POSTGRES_DB=untukmu
# Password role PostgreSQL baru. Generator mengisi ini dan DATABASE_URL dengan nilai yang sama.
# Pada volume lama, mengedit nilai ini tidak mengganti password database yang sudah tersimpan.
POSTGRES_PASSWORD=CHANGE_ME
# Untuk backend yang berjalan di host. Compose memakai host postgres dan POSTGRES_* di atas.
DATABASE_URL=postgresql+asyncpg://untukmu:CHANGE_ME@localhost:5432/untukmu
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=CHANGE_ME_USE_INIT_ENV_SCRIPT
# Simpan kunci instalasi ini bersama backup: diperlukan untuk membaca pesan publik tersimpan.
PUBLIC_CONTENT_KEY=
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=untukmu-private
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Kosong diperbolehkan pada development lokal; produksi membutuhkan konfigurasi Turnstile.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
API_INTERNAL_URL=http://127.0.0.1:8000
SENTRY_DSN=
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
SITE_DOMAIN=
STORAGE_DOMAIN=
