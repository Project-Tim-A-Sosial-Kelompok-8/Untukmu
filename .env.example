# Dari akar proyek: cd backend && go run ./cmd/untukmu init-env
# Template ini bukan .env siap pakai; generator mengisi kunci acak di bawah ini.
# Jangan membagikan .env atau memasukkannya ke repositori.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
# Alamat API Go. Frontend Next.js meneruskan /api/v1 ke alamat ini.
LISTEN_ADDR=127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
# PostgreSQL (mis. Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Kosongkan untuk memakai SQLite lokal di DATABASE_PATH.
DATABASE_URL=
# Database SQLite dan berkas unggahan terenkripsi (relatif terhadap folder backend).
# Backup keduanya bersama .env.
DATABASE_PATH=var/untukmu.db
STORAGE_DIR=var/storage
JWT_SECRET=CHANGE_ME_USE_INIT_ENV
# Simpan kunci instalasi ini bersama backup: diperlukan untuk membaca pesan publik tersimpan.
# Kunci enkripsi isi pesan publik di server. Simpan di Secret Vercel dengan nama
# ini; jangan memakai prefix PUBLIC_ karena Vercel menganggapnya variabel publik.
# Nama lama PUBLIC_CONTENT_KEY masih dibaca sebagai fallback.
CONTENT_ENCRYPTION_KEY=
# Proxy tepercaya yang boleh mengirim X-Forwarded-For (Next.js/Caddy di mesin yang sama).
TRUSTED_PROXIES=127.0.0.1/8,::1/128
# Kosong diperbolehkan pada development lokal; produksi membutuhkan konfigurasi Turnstile.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
METRICS_TOKEN=
SITE_DOMAIN=
