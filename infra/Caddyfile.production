# Production gateway: caddy run --config infra/Caddyfile.production
# Runs on the same host as the Go API (127.0.0.1:8000) and Next.js (127.0.0.1:3000).
# Set SITE_DOMAIN, APP_ORIGIN=https://SITE_DOMAIN and configure Turnstile.
{$SITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	handle /api/v1/storage/upload {
		request_body {
			max_size 32MB
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle /api/* {
		request_body {
			max_size 200KB
		}
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
