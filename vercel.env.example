# Nilai contoh untuk Environment Variables di Vercel.
# Salin nilai nyata dari vercel.env.local (file itu tidak di-commit), atau isi
# langsung di dashboard Vercel: Project -> Settings -> Environment Variables.

# ── Backend (service "backend") ─────────────────────────────────────────────
# production mengaktifkan validasi ketat: APP_ORIGIN harus https, Turnstile
# wajib diisi, dan CONTENT_ENCRYPTION_KEY wajib 32 byte base64url.
ENVIRONMENT=production

# Origin browser yang boleh mengirim cookie. Harus sama persis, tanpa slash
# di akhir. Untuk preview deployment, isi dengan URL preview-nya (env Preview).
APP_ORIGIN=https://untukmu.vercel.app

# PostgreSQL/Neon. Jangan memakai SQLite di Vercel (filesystem sementara).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel hanya menyediakan /tmp yang bisa ditulis. Upload tidak bertahan
# antar-instance; untuk produksi gunakan Vercel Blob/S3.
STORAGE_DIR=/tmp/untukmu-storage

# Acak, minimal 32 karakter. Contoh membuat:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_96_HEX_ACAK

# 32 byte base64url, akhiri dengan "=". Jangan dirotasi jika database sudah
# berisi pesan publik yang dienkripsi dengan kunci ini.
# Nama ini sengaja tanpa prefix PUBLIC_ agar Vercel mengizinkan visibility Secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url')+'=')"
CONTENT_ENCRYPTION_KEY=GANTI_DENGAN_BASE64URL_32_BYTE

# Minimal 32 karakter acak; dipakai untuk endpoint /metrics.
METRICS_TOKEN=GANTI_DENGAN_MINIMAL_32_KARAKTER

# Cloudflare Turnstile: buat widget untuk domain di atas, lalu isi ketiganya.
# TURNSTILE_HOSTNAME tanpa https:// dan tanpa path.
TURNSTILE_SECRET=GANTI_DENGAN_SECRET_KEY_TURNSTILE
TURNSTILE_HOSTNAME=untukmu.vercel.app

# Opsional.
SENTRY_DSN=
SITE_DOMAIN=untukmu.vercel.app
# Di Vercel, X-Forwarded-For diisi oleh edge. Default hanya mempercayai
# localhost; sesuaikan bila pembatasan rate-limit perlu melihat IP pengguna.
TRUSTED_PROXIES=127.0.0.1/8,::1/128

# Batas waktu sesi dan upload; biarkan kosong untuk memakai default kode.
# ACCESS_MINUTES=10
# REFRESH_DAYS=30
# MAX_UPLOAD_BYTES=10485760

# ── Frontend (service "frontend") ───────────────────────────────────────────
# NEXT_PUBLIC_* dibaca saat build, jadi harus sudah ada sebelum deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=GANTI_DENGAN_SITE_KEY_TURNSTILE

# Jangan set LISTEN_ADDR atau API_INTERNAL_URL di Vercel:
# - backend membaca PORT yang disuntikkan Vercel;
# - /api/* ditangani rewrite vercel.json, bukan rewrite Next.js.
